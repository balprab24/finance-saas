NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
# For the bundled docker-compose Postgres (or `brew install postgresql@16`):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
DATABASE_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US
# Base64-encoded 32-byte key for encrypting Plaid access tokens server-side.
PLAID_TOKEN_ENCRYPTION_KEY=
# Optional rotation keyring. Example: v1=<old-base64>,v2=<new-base64>
PLAID_TOKEN_ENCRYPTION_KEYS=
PLAID_TOKEN_ENCRYPTION_KEY_VERSION=v1
# Bearer secret for the Vercel Cron drain endpoint (/api/cron/plaid-sync).
# Generate with `openssl rand -hex 32`. Vercel injects it as the cron request's
# Authorization header. The 5-minute cron cadence requires Vercel Pro.
CRON_SECRET=
# Sentry observability. Use SENTRY_DSN server-side and NEXT_PUBLIC_SENTRY_DSN
# client-side; they may be the same public DSN. Source map upload needs the org,
# project, and auth token in CI/Vercel, not in the browser.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Optional Sentry Cron monitor settings for /api/cron/plaid-sync.
SENTRY_PLAID_SYNC_MONITOR_SLUG=plaid-sync-cron
SENTRY_PLAID_SYNC_MONITOR_SCHEDULE="*/5 * * * *"
